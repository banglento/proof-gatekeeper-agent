# Copy to .env and fill in. NEVER commit a real secret.
# HMAC secret issued by the platform when the agent is registered
# (dashboard -> agent -> Rotate Secret; shown exactly once).
AGENT_GAMES_HMAC_SECRET=

# Port for local development. In production the agent must sit behind a
# public HTTPS endpoint on 443 (no custom ports) that forwards to this.
PORT=8787

# Optional, defence-in-depth only (NOT required for scoring — see PROTOCOL.md):
# Kurier mainnet API key, used if you enable on-chain confirmation of the
# task's proof via Kurier. Leave empty to disable.
KURIER_API_KEY=
